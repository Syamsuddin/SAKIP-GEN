# === Wajib (Fase 0) ===
BOT_TOKEN=123456:GANTI-DENGAN-TOKEN-DARI-BOTFATHER
WEBHOOK_SECRET=ganti-string-acak-url-safe-yang-panjang
PUBLIC_BASE_URL=https://app.contoh.id

# === Operasional ===
SET_WEBHOOK_ON_STARTUP=true
LOG_LEVEL=INFO
ENV=production

# === Akses bot ===
# telegram_id yang otomatis admin (akses bot tanpa /daftar). CSV bila lebih dari satu.
# ADMIN_TELEGRAM_IDS=207118312,123456789

# === Profil skema sumber (adaptasi multi-eSAKIP) ===
# "esakip" = skema eSAKIP nyata (db/mysql/schema.sql); "reference" = skema demo/uji.
# DB_SCHEMA_PROFILE=esakip

# === Skala-keluar (Fase 5/T5.1) — hanya bila WORKERS>1 ===
# WORKERS=4                                  # gunicorn (deploy/gunicorn.conf.py)
# REDIS_URL=redis://127.0.0.1:6379/0         # rate-limit API konsisten lintas worker
# (juga: ENABLE_SCHEDULER=false di web + jalankan `python scheduler_service.py`,
#  serta USE_SQL_AUTH=true agar daftar pengguna konsisten)

# === Opsional — dipakai fase berikutnya ===
# DB_RO_URL=mysql+asyncmy://sakip_ro:password@127.0.0.1:3306/sakip
# DB_STAGING_URL=mysql+asyncmy://sakip_staging:password@127.0.0.1:3306/sakip_ai
# MINIAPP_BASE_URL=https://app.contoh.id/usulan
# TOKEN_SECRET=ganti-kunci-penanda-token-opaque
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001   # Haiku (Anthropic); atau nama model Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
